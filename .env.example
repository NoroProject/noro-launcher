# noro-launcher root env
#
# Copy to `.env` in repo root when running:
#   cargo run -p master
#
# The master binary has a small .env loader and reads this file from the
# current working directory. If you run the binary from another directory,
# put `.env` there or export these variables in the shell.

# --- Master HTTP/public URLs ---
# NORO_PUBLIC_URL and NORO_WEB_URL are REQUIRED: the master refuses to start
# without them. They used to default to localhost, and a production instance
# would happily hand out localhost links in signed manifests and OAuth redirects.
NORO_BIND=0.0.0.0:8080
NORO_PUBLIC_URL=http://localhost:8080
NORO_WEB_URL=http://localhost:3000
NORO_DATA_DIR=./data

# Browser origins allowed to call the API, comma-separated. Unset means "any
# origin" and is meant for local development only — always set it in production.
# NORO_ALLOWED_ORIGINS=https://noro.example.dev

# --- PostgreSQL ---
# REQUIRED. Example local database:
#   createdb noro
#   psql -d noro -c 'CREATE EXTENSION IF NOT EXISTS pgcrypto;'
DATABASE_URL=postgres://postgres:postgres@localhost/noro

# --- Discord OAuth2 ---
# REQUIRED — an empty client id used to mean "master starts, login is broken".
# Discord Developer Portal -> OAuth2 -> General.
# Add these redirects:
#   http://localhost:8080/auth/discord/callback
#   http://localhost:8080/auth/discord/launcher/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Error reporting ---
# Optional. Empty DSN means errors stay in the log; the master says so on start.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- File delivery ---
# Optional. Pull-through CDN in front of the master's /files/{sha1}.
# When set, manifests hand out {NORO_FILES_CDN_URL}/{sha1}. URLs are content-
# addressed, so the CDN never needs a purge. See docs/env.md.
NORO_FILES_CDN_URL=

# --- Optional integrations ---
# Needed for CurseForge import/add by project_id/file_id.
CURSEFORGE_API_KEY=

# Needed for the master-side launcher builder/deploy flow. Unset, the builder
# now refuses to run — it used to fall back to the upstream Noro repository and
# ship those binaries to players.
NORO_GITHUB_REPO=owner/repo
GITHUB_TOKEN=
NORO_LAUNCHER_REPO=/absolute/path/to/noro-launcher

# --- Signing ---
# Optional for development. If empty, master and launcher use the shared dev key.
# Production value: 32-byte ed25519 seed as 64 hex chars.
NORO_SIGNING_KEY=
#
# Launcher/backend compile-time public key for production builds:
#   NORO_SIGNING_PUBKEY=<32-byte-public-key-64-hex> cargo build --release -p noro_launcher

# --- Launcher backend / admin CLI ---
# Used by launcher/backend default config and noro-admin. Baked in at build time
# for release launchers, where it is mandatory (see crates/noro_launcher/verify.rs).
NORO_MASTER_URL=http://localhost:8080
NORO_ADMIN_TOKEN=

# --- Web (Nuxt) ---
# REQUIRED for a production web build: without them useApi throws instead of
# quietly pointing the site at somebody else's master.
NUXT_PUBLIC_MASTER_URL=http://localhost:8080
NUXT_PUBLIC_WEB_URL=http://localhost:3000
# Optional, same rule as the master's SENTRY_DSN.
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_ENVIRONMENT=development
