# Copy to oci-launch.env and fill in. Values below are for the noro tenancy.
OCI_PROFILE=noro

# Root compartment == tenancy: all resources live there.
COMPARTMENT_ID=ocid1.tenancy.oc1..aaaaaaaauoeyovjrfz7j2zft6tfmfkw2g43oitbeejloz7nl474cthh45dra

# Regional subnet "Mine" (10.0.0.0/24), public IPs allowed.
SUBNET_ID=ocid1.subnet.oc1.uk-london-1.aaaaaaaawjd3f5xye7qi6s6rl2f7pr6cflloebmdjxztp3y2fqq2slbmcd4a

# AD=<boot volume in that AD>, space-separated. A boot volume cannot be used
# outside its own AD, so each AD needs a copy restored from a backup.
# AD-3 is omitted on purpose: standard-a1-core-count there is 0.
TARGETS="tiTw:UK-LONDON-1-AD-1=<restored-volume-ocid> tiTw:UK-LONDON-1-AD-2=ocid1.bootvolume.oc1.uk-london-1.abwgiljrwnxhhafnelv34nit7yotjhrv6nrekeabbswtuhviiq3yv3opfvna"

# Free-tier ceiling in this tenancy is 2 OCPU / 12 GB per AD.
SHAPE=VM.Standard.A1.Flex
OCPUS=2
MEM_GB=12

DISPLAY_NAME=noro-prod
SLEEP_OK=120
SLEEP_THROTTLE=900

# Optional Telegram alert on success (and on a fatal stop). Both must be set,
# otherwise notifications are silently skipped. Keep the real file at 600.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
