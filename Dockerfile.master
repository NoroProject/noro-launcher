FROM rust:1.89-bookworm AS builder
WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

RUN cargo build --release -p master --bin noro-master

FROM debian:bookworm-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/noro-master /usr/local/bin/noro-master

RUN useradd -m -u 10001 noro
USER noro

ENV NORO_BIND=0.0.0.0:8080
ENV NORO_DATA_DIR=/app/data

EXPOSE 8080
CMD ["noro-master"]
