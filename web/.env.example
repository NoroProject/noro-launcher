# Nuxt web env
#
# Copy to `web/.env` when running:
#   cd web
#   bun run dev

# Public URL of the Rust master API.
NUXT_PUBLIC_MASTER_URL=http://localhost:8080

# Public URL of this Nuxt app. Used to build Discord OAuth return URL.
NUXT_PUBLIC_WEB_URL=http://localhost:3000

# Both are required in a production build: `useApi` throws a named error rather
# than falling back to a hardcoded domain. `nuxt dev` still defaults to localhost.

# Error reporting. Empty DSN keeps Sentry inert.
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_ENVIRONMENT=development
