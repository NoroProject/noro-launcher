/target
**/target
.env
.env.*
!.env.example
*.log
*.tmp
*.swp
*.swo
.DS_Store
.idea/
.vscode/

# web
web/node_modules
web/.nuxt
web/.output
web/dist
web/bun.lockb
web/.cache
web/.vercel
web/.turbo
web/coverage

# java-агенты
agent/**/.gradle/
# Одним правилом на любую глубину: у версионных сборок каталог лежит в
# agent/mod/versions/<mc>-<loader>/build, и прежние agent/build + agent/*/build
# до него не доставали — 1138 артефактов оказались в индексе.
agent/**/build/
agent/**/bin/
*.class
agent/**/run
agent/**/.classpath
agent/**/.project
agent/**/.settings/

# данные мастера
/data
master_data/
*.sqlite
*.db
*.sqlite-shm
*.sqlite-wal

# ключи (не коммитим приватные ключи подписи)
*.pem
ed25519_private*
secrets/
*.p12
*.jks
*.keystore

# Черновики и архивы под рукой: собранные агенты, распаковки, разовые скрипты.
/scratch/

# Клоны чужих репозиториев, с которыми делаются мосты к NoroAgentApi: TAB и
# StyledChat. Лежат в vendor/, чтобы не мешаться в корне, и в индекс не идут —
# у каждого свой upstream.
# 915 МБ со своим .git внутри — одна `git add -A`, и это уедет в историю.
/vendor/
